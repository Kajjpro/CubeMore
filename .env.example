# Copy this file to ".env" to change settings locally (optional).
# On Fly.io these are set in fly.toml instead.

# The port the server listens on. (The Vite dev website always uses 5173.)
PORT=3001

# "production" = the server also serves the built website from client/dist
# (run "npm run build" first). Leave it out while developing.
# NODE_ENV=production

# Website hosted somewhere else (e.g. Vercel)? List its address(es) here, separated
# by commas, so browsers are allowed to connect from there. Set this on the SERVER.
# CLIENT_ORIGINS=https://cube-racing.vercel.app

# The game server's address, for a website hosted somewhere else (e.g. Vercel).
# Set this on VERCEL (it is baked into the website when it is built).
# VITE_SERVER_URL=https://cube-racing-khaliun.fly.dev

# Where the built website is (only used in production). Default: client/dist
# CLIENT_DIST=/app/client/dist

# A Postgres database (Neon, Supabase, Render...). With it, rooms survive restarts,
# every match is kept in the history, and the daily leaderboard is kept.
# Leave it out and everything is kept in memory (reset on restart).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The site's public address (no slash at the end). Link previews on Facebook,
# WhatsApp, Discord... need full addresses, and search engines read the sitemap.
# Baked into the website when it's built.
# VITE_SITE_URL=https://cubemore.com

# Accounts: sign in with Google, or email and password, through Clerk (clerk.com).
# Both keys are on the Clerk dashboard → Configure → API keys. Leave them out and
# there's no sign-in: everyone races as a guest with a nickname (see DEPLOY.md).
# The publishable key is for the website (baked in when it's built);
# the secret key is for the server only. Never put the secret key in the website.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# In production: the website's address, so tokens from other sites are refused.
# CLERK_AUTHORIZED_PARTIES=https://cubits.onrender.com

# Who may open /admin (stats and contact messages): your account's email address
# (once verified in Clerk) or Clerk user id ("user_..."), separated by commas.
# ADMIN_USER_IDS=you@example.com

# Voice / video calls: a TURN relay for players whose network blocks direct
# connections (optional; see DEPLOY.md). Comma-separated addresses.
# TURN_URLS=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=...
# TURN_CREDENTIAL=...

# Cloudflare Web Analytics (optional, free, no cookies): page views, countries, devices
# and where visitors come from. The token is on the Cloudflare dashboard (see DEPLOY.md).
# Baked into the website when it's built. Your own visitor counts on /admin work without it.
# VITE_CF_ANALYTICS_TOKEN=...

# The solve analyzer's AI coach (optional, free): a key from Google AI Studio
# (aistudio.google.com -> Get API key). Leave it out and the analyzer still shows all
# its own suggestions; only the written "coach summary" is off. See DEPLOY.md.
# GEMINI_API_KEY=...
# Which Gemini model writes the summaries (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# The weekly smart-cube race (3x3 ao5, smart cubes only): day (0 = Sunday ...
# 6 = Saturday) and hour, in UTC. The room opens 30 minutes before. Default: Saturday 12:00 UTC.
# WEEKLY_RACE_DAY=6
# WEEKLY_RACE_HOUR_UTC=12

# How long the screens between solves last, in milliseconds.
# Normally you don't change these (the chaos test uses shorter ones).
# SOLVE_REVIEW_MS=0 skips the review screen: the next scramble comes right away.
SOLVE_REVIEW_MS=0
SET_RESULT_MS=6000
# With a solve time limit: extra time after the deadline to send a time that
# was stopped in time (while picking OK / +2 / DNF).
SUBMIT_GRACE_MS=6000
